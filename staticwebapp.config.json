{
  "routes": [
    {
      "route": "/",
      "rewrite": "/login.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/login.html",
    "exclude": [
      "/images/*.{png,jpg,gif}",
      "/assets/*",
      "/css/*",
      "*.js",
      "*.css"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}